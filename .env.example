APP_NAME="Meezan Property"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Meezan Property -------------------------------------------------------
# Public, company-owned contact details. Leave blank to hide them.
MEEZAN_CONTACT_EMAIL=
MEEZAN_CONTACT_PHONE=
MEEZAN_WHATSAPP_NUMBER=
MEEZAN_MARLA_SQFT=225

# Map tiles (Leaflet). OpenStreetMap suits development and light traffic;
# use a commercial tile provider before high-traffic launch.
MEEZAN_MAP_ENABLED=true
MEEZAN_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MEEZAN_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
# Map search (MapLibre) style JSON. Default: OpenFreeMap "liberty" (OpenStreetMap data, no key,
# donation-funded, no service guarantee). Empty = draw MEEZAN_MAP_TILE_URL instead.
MEEZAN_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Nearby places on listings with an exact pin (OpenStreetMap Overpass API,
# cached 30 days). Use a self-hosted or commercial Overpass endpoint at launch.
MEEZAN_NEARBY_ENABLED=true
MEEZAN_OVERPASS_URL=https://overpass-api.de/api/interpreter

# AI requirement parsing: "rules" is the built-in, database-backed default.
MEEZAN_AI_DRIVER=rules

# Require a confirmed email before sharing requirements or creating listings.
# Turn on only once outgoing mail (MAIL_MAILER) works. Emails are queued:
# run `php artisan queue:work` (or `composer run dev`) to send them.
MEEZAN_REQUIRE_EMAIL_VERIFICATION=false

# Security and operations (see docs/Hostinger_Deployment_Runbook.md).
# Strict Content-Security-Policy; leave on.
MEEZAN_CSP_ENABLED=true

# SEO: category landing pages are indexed (and listed in the sitemap) only
# with at least this many real, non-demo listings.
MEEZAN_SEO_MIN_LISTINGS=3
# Staging/test copies only: true sends "X-Robots-Tag: noindex, nofollow" on every page.
# Must stay false on the live site.
MEEZAN_SEO_NOINDEX_SITE=false
# Shared hosting without a long-running queue worker: let the cron-driven
# scheduler send queued emails every minute.
MEEZAN_QUEUE_VIA_SCHEDULER=false
# Behind Cloudflare or another proxy: a comma-separated list of its IPs or ranges.
# Leave empty with no proxy. See docs/Hostinger_Deployment_Runbook.md before using "*".
TRUSTED_PROXIES=
# Production: true (cookies only over HTTPS).
SESSION_SECURE_COOKIE=false

# WhatsApp Business Platform (Cloud API). Nothing is sent unless WHATSAPP_ENABLED=true,
# the access token is set and mock mode is off. Test mode can only send to
# WHATSAPP_TEST_RECIPIENT. Put the three secrets in .env only, never in source or chat.
# MEEZAN_WHATSAPP_NUMBER is the number customers see on the website. It is not the API sender.
WHATSAPP_ENABLED=true
WHATSAPP_MODE=test

# true: messages are recorded and nothing is sent. Turning it off is always a manual step.
WHATSAPP_MOCK_MODE=true

META_APP_ID=4648794348780467
META_BUSINESS_PORTFOLIO_ID=2203264836668579
META_APP_SECRET=

WHATSAPP_BUSINESS_ACCOUNT_ID=4747186985562911

WHATSAPP_TEST_PHONE_NUMBER_ID=1397844586749907
WHATSAPP_TEST_PHONE_NUMBER=+15551374226
WHATSAPP_TEST_RECIPIENT=923111749849

# Production stays empty until the owner switches WHATSAPP_MODE=production.
WHATSAPP_PROD_PHONE_NUMBER_ID=
WHATSAPP_PROD_WABA_ID=

WHATSAPP_ACCESS_TOKEN=

WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com

WHATSAPP_VERIFY_TOKEN=
# The public HTTPS callback, once deployed and verified. Empty: the address is built from APP_URL.
WHATSAPP_WEBHOOK_URL=

WHATSAPP_TIMEOUT=30
WHATSAPP_MAX_RETRIES=3

# Google Gemini API: the language model for the Central AI Brain, all 16 agents,
# website AI and WhatsApp AI. Server-side only: never expose the key to the
# browser. Get a key in Google AI Studio (https://aistudio.google.com/apikey).
# A key can instead be saved, encrypted, in Admin -> AI Command Center -> Gemini
# Settings (that one wins). Without a key, agents run in rules mode (data only).
GEMINI_API_KEY=
# Empty = gemini-3.8-flash (Google's recommended Flash model on 4 Nov 2026).
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=60
GEMINI_MAX_RETRIES=2
# minimal | low | medium | high (Gemini 3 and later); thinking is billed as output.
GEMINI_THINKING_LEVEL=low
GEMINI_MIN_OUTPUT_TOKENS=512
# free | paid. On the free tier Google may use request content to improve its products.
GEMINI_BILLING_TIER=free
# Optional model per workload tier (empty = GEMINI_MODEL).
GEMINI_MODEL_ROUTINE=
GEMINI_MODEL_EXTRACTION=
GEMINI_MODEL_SUPPORT=
GEMINI_MODEL_RESEARCH=
GEMINI_MODEL_REASONING=
MEEZAN_AI_PROVIDER=gemini
# Mask phone numbers, e-mail addresses, CNIC and card numbers before text is sent to Gemini.
MEEZAN_AI_REDACT_PERSONAL_DATA=true
# Only meaningful with a second provider registered (none by default).
MEEZAN_AI_FALLBACK=false

# AI agents (Phase 15). Limits and budgets; a monthly budget also needs a model
# price (Google's published prices are configured; Admin -> Usage & Cost overrides).
MEEZAN_AGENTS_USE_LLM=true
# Model turns per task for agents switched to "model tool calls" (Gemini function calling).
MEEZAN_AGENT_MAX_MODEL_TOOL_ROUNDS=4
MEEZAN_AGENT_MAX_TOOL_CALLS=25
MEEZAN_AGENT_MAX_DEPTH=2
MEEZAN_AGENT_MAX_SUBTASKS=8
MEEZAN_AGENT_MAX_ATTEMPTS=2
MEEZAN_AGENT_MAX_SECONDS=60
MEEZAN_AGENT_MAX_TOKENS_PER_TASK=8000
MEEZAN_AGENT_DAILY_TOKENS=200000
MEEZAN_AGENTS_DAILY_TOKENS=1000000
MEEZAN_AGENTS_DAILY_COST_USD=
# Queue agent tasks on new listings, dealer registrations and leads.
MEEZAN_AGENT_EVENTS=true
MEEZAN_AGENT_QUEUE=agents

# Investment Rankings demo data (php artisan meezan:investment-demo seed). false =
# real verified data only (the Meezan Investment Index never uses demo data);
# true = signed-in administrators preview the illustrative snapshot with a DEMO
# notice; public visitors never see it. Admins can override it in Market Data Centre -> Demo Data.
INVESTMENT_DEMO_MODE=false
# Queued agent tasks need a worker: php artisan queue:work --queue=whatsapp,default,agents
# (shared hosting: MEEZAN_QUEUE_VIA_SCHEDULER=true drains all three from the cron).

# Optional connectors used by agents (status only until configured and checked).
GOOGLE_SEARCH_CONSOLE_SITE=
GOOGLE_SEARCH_CONSOLE_CREDENTIALS=
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_CREDENTIALS=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_PAGE_ACCESS_TOKEN=
SMS_PROVIDER=
SMS_API_KEY=
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=

# Billing (Phase 9). Packages and prices are managed in Admin -> Packages.
# Bank transfer is offered only when enabled AND an account title plus
# account number or IBAN are set. The mock gateway is for local testing and
# is never available when APP_ENV=production.
MEEZAN_MANUAL_PAYMENTS=false
MEEZAN_BANK_NAME=
MEEZAN_BANK_ACCOUNT_TITLE=
MEEZAN_BANK_ACCOUNT_NUMBER=
MEEZAN_BANK_IBAN=
MEEZAN_MOCK_PAYMENTS=false
MEEZAN_MOCK_WEBHOOK_SECRET=
MEEZAN_INVOICE_PREFIX=MP
MEEZAN_OVER_LIMIT_POLICY=keep_live
MEEZAN_LEAD_OVERFLOW=queue
