APP_NAME="Meezan Property"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Meezan Property -------------------------------------------------------
# Public, company-owned contact details. Leave blank to hide them.
MEEZAN_CONTACT_EMAIL=
MEEZAN_CONTACT_PHONE=
MEEZAN_WHATSAPP_NUMBER=
MEEZAN_MARLA_SQFT=225

# Map tiles (Leaflet). OpenStreetMap suits development and light traffic;
# use a commercial tile provider before high-traffic launch.
MEEZAN_MAP_ENABLED=true
MEEZAN_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MEEZAN_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"

# Nearby places on listings with an exact pin (OpenStreetMap Overpass API,
# cached 30 days). Use a self-hosted or commercial Overpass endpoint at launch.
MEEZAN_NEARBY_ENABLED=true
MEEZAN_OVERPASS_URL=https://overpass-api.de/api/interpreter

# AI requirement parsing: "rules" is the built-in, database-backed default.
MEEZAN_AI_DRIVER=rules

# Require a confirmed email before sharing requirements or creating listings.
# Turn on only once outgoing mail (MAIL_MAILER) works. Emails are queued:
# run `php artisan queue:work` (or `composer run dev`) to send them.
MEEZAN_REQUIRE_EMAIL_VERIFICATION=false

# Security and operations (see docs/Hostinger_Deployment_Runbook.md).
# Strict Content-Security-Policy; leave on.
MEEZAN_CSP_ENABLED=true
# Shared hosting without a long-running queue worker: let the cron-driven
# scheduler send queued emails every minute.
MEEZAN_QUEUE_VIA_SCHEDULER=false
# Behind Cloudflare or another proxy: "*" or a comma-separated list of proxy IPs.
TRUSTED_PROXIES=
# Production: true (cookies only over HTTPS).
SESSION_SECURE_COOKIE=false

# WhatsApp Business Platform (Cloud API). Nothing is sent unless
# WHATSAPP_SEND_ENABLED=true and all four credentials are set.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_SEND_ENABLED=false

# Optional LLM for requirement parsing (MEEZAN_AI_DRIVER=llm). Keep server-side only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
