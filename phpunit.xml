<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <!-- Tests simulate service failures on purpose; keep those warnings out of storage/logs/laravel.log. -->
        <env name="LOG_CHANNEL" value="null"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Tests choose these per case; a developer's local .env must not change results. -->
        <env name="MEEZAN_WHATSAPP_DRIVER" value="meta"/>
        <env name="WHATSAPP_PHONE_NUMBER_ID" value=""/>
        <env name="WHATSAPP_ACCESS_TOKEN" value=""/>
        <env name="WHATSAPP_APP_SECRET" value=""/>
        <env name="WHATSAPP_VERIFY_TOKEN" value=""/>
        <env name="WHATSAPP_SEND_ENABLED" value="false"/>
        <env name="WHATSAPP_GRAPH_VERSION" value="v21.0"/>
        <!-- The suite tests production rules; test-mode cases switch it on themselves. -->
        <env name="WHATSAPP_MODE" value="production"/>
        <env name="WHATSAPP_ENABLED" value="false"/>
        <env name="WHATSAPP_MOCK_MODE" value=""/>
        <env name="WHATSAPP_GRAPH_API_VERSION" value=""/>
        <env name="WHATSAPP_PROD_PHONE_NUMBER_ID" value=""/>
        <env name="WHATSAPP_PROD_WABA_ID" value="test-waba"/>
        <env name="WHATSAPP_TEST_PHONE_NUMBER_ID" value=""/>
        <env name="WHATSAPP_TEST_PHONE_NUMBER" value=""/>
        <env name="WHATSAPP_TEST_RECIPIENT" value=""/>
        <env name="WHATSAPP_BUSINESS_ACCOUNT_ID" value=""/>
        <env name="WHATSAPP_WEBHOOK_URL" value=""/>
        <env name="META_APP_ID" value=""/>
        <env name="META_BUSINESS_PORTFOLIO_ID" value=""/>
        <env name="META_APP_SECRET" value=""/>
        <env name="MEEZAN_WHATSAPP_NUMBER" value=""/>
        <env name="MEEZAN_MOCK_PAYMENTS" value="false"/>
        <!-- Real keys in a developer's .env must never be used or billed by a test run. -->
        <env name="OPENAI_API_KEY" value=""/>
        <env name="OPENAI_MODEL" value="gpt-4o-mini"/>
        <env name="ANTHROPIC_API_KEY" value=""/>
        <env name="OPENAI_BASE_URL" value="https://api.openai.com/v1"/>
        <env name="ANTHROPIC_BASE_URL" value="https://api.anthropic.com"/>
        <!-- Agent tasks triggered by model events stay off in tests unless a test turns them on (AgentWorkforceTest). -->
        <env name="MEEZAN_AGENT_EVENTS" value="false"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
